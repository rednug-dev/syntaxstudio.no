# Copy to .env.local for local development. Never commit real credentials.
# Zoho EU SMTP: required only for contact-form delivery.
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=

# Optional server-side mail labels/routing; these are the application defaults.
MAIL_FROM_NAME=Syntax
SALES_INBOX=info@syntaxstudio.no

# Optional public HTTPS practice sites. Leave blank until domains are confirmed.
# Empty or invalid values use the internal contact route for that practice.
# NEXT_PUBLIC values are included at build time; rebuild after changing them.
NEXT_PUBLIC_ISO400_URL=
NEXT_PUBLIC_35MM_URL=
NEXT_PUBLIC_NYFANE_URL=
